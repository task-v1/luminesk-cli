{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/task-v1/luminesk-cli/2.0/schemas/luminesk-v1.schema.json",
  "title": "Luminesk database recipe manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "package", "runtime"],
  "properties": {
    "manifest_version": {"const": 1},
    "template": {"$ref": "#/$defs/safePath"},
    "package": {"$ref": "#/$defs/package"},
    "inputs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/input"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "files": {
      "type": "array",
      "items": {"$ref": "#/$defs/file"}
    },
    "ownership": {"$ref": "#/$defs/ownership"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "build": {"$ref": "#/$defs/build"},
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "update": {"$ref": "#/$defs/update"},
    "x": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    }
  },
  "anyOf": [
    {"required": ["template"]},
    {"required": ["build"]},
    {"properties": {"sources": {"minItems": 1}}, "required": ["sources"]},
    {"properties": {"files": {"minItems": 1}}, "required": ["files"]}
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f\\u007f]+$"
    },
    "safePathOrDot": {
      "anyOf": [
        {"const": "."},
        {"$ref": "#/$defs/safePath"}
      ]
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9]+/[a-z0-9][a-z0-9_-]*$"
    },
    "port": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 65535},
        {"type": "string", "pattern": "^\\$\\{input\\.[A-Za-z0-9_-]+\\}$"}
      ]
    },
    "repositoryName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "webUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "stringArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "pathArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safePath"}
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kind", "game", "edition"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "display_name": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {"enum": ["core", "template"]},
        "game": {"const": "minecraft"},
        "edition": {"enum": ["java", "bedrock", "cross-platform"]},
        "summary": {"type": "string"},
        "keywords": {"$ref": "#/$defs/stringArray"},
        "license": {"$ref": "#/$defs/nonEmptyString"},
        "authors": {"$ref": "#/$defs/stringArray"},
        "platforms": {
          "type": "array",
          "items": {"$ref": "#/$defs/platform"}
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "integer", "boolean"]},
        "default": {"type": ["string", "integer", "boolean"]},
        "prompt": {"$ref": "#/$defs/nonEmptyString"},
        "min": {"type": "integer"},
        "max": {"type": "integer"},
        "pattern": {"$ref": "#/$defs/nonEmptyString"},
        "required": {"type": "boolean"},
        "secret": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "string"}}},
          "then": {"properties": {"default": {"type": "string"}}}
        },
        {
          "if": {"properties": {"type": {"const": "integer"}}},
          "then": {"properties": {"default": {"type": "integer"}}}
        },
        {
          "if": {"properties": {"type": {"const": "boolean"}}},
          "then": {"properties": {"default": {"type": "boolean"}}}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "target", "options"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {
          "enum": [
            "http",
            "maven",
            "jenkins",
            "github-release",
            "github-source",
            "gitlab-release",
            "gitlab-job-artifact",
            "mojang-version",
            "paper"
          ]
        },
        "target": {"$ref": "#/$defs/safePathOrDot"},
        "max_size": {"type": "integer", "minimum": 1},
        "extract": {"type": "boolean"},
        "platforms": {
          "type": "array",
          "items": {"$ref": "#/$defs/platform"}
        },
        "allow_http": {"type": "boolean"},
        "allow_private_network": {"type": "boolean"},
        "options": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "http"}}}, "then": {"properties": {"options": {"$ref": "#/$defs/httpOptions"}}}},
        {"if": {"properties": {"type": {"const": "maven"}}}, "then": {"properties": {"options": {"$ref": "#/$defs/mavenOptions"}}}},
        {"if": {"properties": {"type": {"const": "jenkins"}}}, "then": {"properties": {"options": {"$ref": "#/$defs/jenkinsOptions"}}}},
        {"if": {"properties": {"type": {"const": "github-release"}}}, "then": {"properties": {"options": {"$ref": "#/$defs/githubReleaseOptions"}}}},
        {"if": {"properties": {"type": {"const": "github-source"}}}, "then": {"properties": {"extract": {"const": true}, "options": {"$ref": "#/$defs/githubSourceOptions"}}}},
        {"if": {"properties": {"type": {"const": "gitlab-release"}}}, "then": {"properties": {"options": {"$ref": "#/$defs/gitlabReleaseOptions"}}}},
        {"if": {"properties": {"type": {"const": "gitlab-job-artifact"}}}, "then": {"properties": {"options": {"$ref": "#/$defs/gitlabJobArtifactOptions"}}}},
        {"if": {"properties": {"type": {"const": "mojang-version"}}}, "then": {"properties": {"options": {"$ref": "#/$defs/mojangVersionOptions"}}}},
        {"if": {"properties": {"type": {"const": "paper"}}}, "then": {"properties": {"options": {"$ref": "#/$defs/paperOptions"}}}},
        {"if": {"properties": {"target": {"const": "."}}}, "then": {"properties": {"extract": {"const": true}}, "required": ["extract"]}}
      ]
    },
    "httpOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"$ref": "#/$defs/webUrl"},
        "version": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "mavenOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "group", "artifact", "version"],
      "properties": {
        "repository": {"$ref": "#/$defs/webUrl"},
        "group": {"$ref": "#/$defs/nonEmptyString"},
        "artifact": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "extension": {"$ref": "#/$defs/nonEmptyString"},
        "classifier": {"$ref": "#/$defs/nonEmptyString"},
        "channel": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "jenkinsOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "job", "artifact"],
      "properties": {
        "base_url": {"$ref": "#/$defs/webUrl"},
        "job": {"$ref": "#/$defs/nonEmptyString"},
        "artifact": {"$ref": "#/$defs/safePath"},
        "build": {"type": ["string", "integer"]}
      }
    },
    "githubReleaseOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "asset"],
      "properties": {
        "repository": {"$ref": "#/$defs/repositoryName"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "asset": {"$ref": "#/$defs/nonEmptyString"},
        "channel": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "githubSourceOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {"$ref": "#/$defs/repositoryName"},
        "ref": {"$ref": "#/$defs/nonEmptyString"},
        "path": {"$ref": "#/$defs/safePath"}
      }
    },
    "gitlabReleaseOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "asset"],
      "properties": {
        "base_url": {"$ref": "#/$defs/webUrl"},
        "project": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "asset": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "gitlabJobArtifactOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "job", "artifact"],
      "properties": {
        "base_url": {"$ref": "#/$defs/webUrl"},
        "project": {"$ref": "#/$defs/nonEmptyString"},
        "ref": {"$ref": "#/$defs/nonEmptyString"},
        "job": {"$ref": "#/$defs/nonEmptyString"},
        "artifact": {"$ref": "#/$defs/safePath"}
      }
    },
    "mojangVersionOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "paperOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minecraft"],
      "properties": {
        "minecraft": {"$ref": "#/$defs/nonEmptyString"},
        "build": {"type": ["string", "integer"]}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/safePath"},
        "target": {"$ref": "#/$defs/safePath"},
        "mode": {"enum": ["managed", "preserve", "generated", "data"]},
        "template": {"type": "boolean"},
        "executable": {"type": "boolean"}
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserve": {"$ref": "#/$defs/pathArray"},
        "data": {"$ref": "#/$defs/pathArray"},
        "executable": {"$ref": "#/$defs/pathArray"}
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/safePathOrDot"},
        "target": {"$ref": "#/$defs/nonEmptyString"},
        "mode": {"enum": ["ro", "rw"]}
      }
    },
    "runtimePort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "container"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "host": {"$ref": "#/$defs/port"},
        "container": {"$ref": "#/$defs/port"},
        "protocol": {"enum": ["tcp", "udp"]}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "command"],
      "properties": {
        "image": {"$ref": "#/$defs/nonEmptyString"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "workdir": {"$ref": "#/$defs/nonEmptyString"},
        "memory": {"$ref": "#/$defs/nonEmptyString"},
        "stop_signal": {"$ref": "#/$defs/nonEmptyString"},
        "stop_timeout": {"type": "integer", "minimum": 1},
        "restart": {"$ref": "#/$defs/nonEmptyString"},
        "restart_limit": {"type": "integer", "minimum": 0},
        "run_as": {"$ref": "#/$defs/nonEmptyString"},
        "read_only_root": {"type": "boolean"},
        "mounts": {"type": "array", "items": {"$ref": "#/$defs/mount"}},
        "ports": {"type": "array", "items": {"$ref": "#/$defs/runtimePort"}}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "output"],
      "properties": {
        "file": {"$ref": "#/$defs/safePath"},
        "output": {"type": "string", "pattern": "^/"},
        "timeout": {"type": "integer", "minimum": 1},
        "cpu": {"type": "integer", "minimum": 1},
        "memory": {"$ref": "#/$defs/nonEmptyString"},
        "network": {"type": "boolean"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "phase": {"enum": ["post-build", "post-install", "readiness"]},
        "kind": {"enum": ["file", "process-alive", "log-regex", "tcp", "command"]},
        "required": {"type": "boolean"},
        "path": {"$ref": "#/$defs/safePath"},
        "pattern": {"$ref": "#/$defs/nonEmptyString"},
        "host": {"$ref": "#/$defs/nonEmptyString"},
        "port": {"$ref": "#/$defs/port"},
        "command": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "timeout": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "file"}}}, "then": {"required": ["path"]}},
        {"if": {"properties": {"kind": {"const": "log-regex"}}}, "then": {"required": ["pattern"]}},
        {"if": {"properties": {"kind": {"const": "command"}}}, "then": {"properties": {"command": {"minItems": 1}}, "required": ["command"]}}
      ]
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {"const": "transactional"},
        "backup": {"$ref": "#/$defs/pathArray"},
        "retain_backups": {"type": "integer", "minimum": 0},
        "rollback_on_failure": {"type": "boolean"}
      }
    }
  },
  "$comment": "The CLI additionally enforces cross-field uniqueness, path portability, URL credential policy, ownership overlap rules, input bounds, and readiness phase/kind compatibility. local-file is intentionally excluded from official database recipes."
}
